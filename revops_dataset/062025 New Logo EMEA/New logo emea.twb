      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[Clipboard_20250619T123014].[pcto:usr:Calculation_5720134499239837699:qk]&quot;' value='Win Rate' />
          <alias key='&quot;[Clipboard_20250619T123014].[usr:Calculation_5720134499239837699:qk]&quot;' value='New Logo RCN closed' />
          <alias key='&quot;[Clipboard_20250619T123014].[win:avg:Age:qk:8]&quot;' value='Average sales cycle' />
          <alias key='&quot;[Clipboard_20250619T123014].[win:avg:Age:qk]&quot;' value='Sales Cycle (days)' />
          <alias key='&quot;[Clipboard_20250619T123014].[win:usr:Calculation_5720134499252625414:qk]&quot;' value='Average win rate' />
        </aliases>
      </column>
      <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
      <column datatype='real' name='[Amount]' role='measure' type='quantitative' />
      <column caption='Qualified date' datatype='date' fiscal-year-start='0' name='[Calculation_5720134499236474880]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(&#10;  INT(SPLIT(SPLIT([Qualified Date], &quot; &quot;, 1), &quot;/&quot;, 3)),  // Year&#10;  INT(SPLIT(SPLIT([Qualified Date], &quot; &quot;, 1), &quot;/&quot;, 1)),  // Month&#10;  INT(SPLIT(SPLIT([Qualified Date], &quot; &quot;, 1), &quot;/&quot;, 2))   // Day&#10;)' />
      </column>
      <column caption='Opp count' datatype='integer' name='[Calculation_5720134499237928961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Opportunity Name])' />
      </column>
      <column caption='RCN count' datatype='integer' name='[Calculation_5720134499239837699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Reporting Company Name])' />
      </column>
      <column caption='Winrate' datatype='real' default-format='p0%' name='[Calculation_5720134499252625414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Stage] = &quot;Closed Won&quot; THEN 1 END) &#10;/ &#10;COUNTD([Opportunity Name])' />
      </column>
      <column caption='Closed won count' datatype='integer' name='[Calculation_5720134499254534151]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Stage] = &quot;Closed Won&quot; then 1 else 0 end' />
      </column>
      <column caption='Measure selector' datatype='real' name='[Calculation_5720134499268821001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &quot;RCN&quot; Then [Calculation_5720134499239837699] ELSEIF &#10;[Parameters].[Parameter 1] = &quot;TCV&quot; then SUM([Amount]) elseif &#10;[Parameters].[Parameter 1] = &quot;NBACV&quot; then SUM([New Business ACV]) END' />
      </column>
      <column caption='Text' datatype='string' name='[Calculation_5720134499302928396]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Qualified to close age' datatype='integer' name='[Calculation_6999930849917308929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Close Date] - [Calculation_5720134499236474880]' />
